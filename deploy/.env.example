# 서버(EC2) compose 환경변수 — 실제 파일은 /home/ubuntu/dlab-api/.env (chmod 600)
#
# ★ 이 예시 파일만 커밋한다. 값이 채워진 실물은 절대 레포에 올리지 않는다(CLAUDE.md §8).
# ★ 루트의 .env.example(로컬 개발용)과 다른 파일이다. 이쪽은 서버 전용이다.
#
# compose .env 문법 주의:
#   - `KEY=VALUE` 한 줄씩. export 를 붙이지 않는다.
#   - ★ 따옴표를 쓰지 않는다. systemd 와 달리 compose 는 따옴표를 벗기지 않고
#     값의 일부로 넘긴다 — 비밀번호가 "abc" 로 저장돼 인증에 실패한다.
#   - 값에 $ 가 들어가면 $$ 로 이스케이프한다(변수 치환으로 먹힌다).
#     비밀번호를 생성할 때 $ 가 없는 것으로 고르는 편이 사고가 적다.

# --- PostgreSQL ---
# ★ 이 셋은 db 볼륨이 비어 있을 때 딱 한 번만 반영된다(최초 기동의 initdb).
#   나중에 값을 바꿔도 DB에는 반영되지 않는다 — deploy/README.md "비밀번호 변경" 참고.
POSTGRES_DB=dlab_dev
POSTGRES_USER=dlab_app
POSTGRES_PASSWORD=여기에_실제_비밀번호

# --- JWT ---
# ★ 기본값 없음 — 없으면 앱이 기동에 실패한다(application-prod.yml 의 의도된 설계).
#   HS256이 256비트를 요구하므로 32바이트 이상. 생성: openssl rand -base64 48
JWT_SECRET=여기에_32바이트_이상_난수

# --- 앱 이미지 ---
# 워크플로는 배포마다 커밋 SHA 태그를 직접 넘기므로 이 값을 쓰지 않는다.
# 서버에서 수동으로 `docker compose up -d` 할 때의 기본값이다.
APP_IMAGE=ghcr.io/daesung-free/dlab-api:latest

# --- JVM ---
# 컨테이너 메모리 한도를 JVM이 인식하고 그 비율만큼 쓴다(-Xmx 고정 금지).
# timezone 은 출결 일자 집계·미등원 스케줄러의 날짜 경계 기준이라 반드시 고정한다.
JAVA_OPTS=-XX:MaxRAMPercentage=70 -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Seoul

# --- Redis ---
# 비밀번호 없이 운영한다. 대신 compose 에서 포트를 공개하지 않아
# 같은 네트워크의 app 컨테이너에서만 닿는다. 외부에 열려면 반드시 비밀번호를 먼저 건다.

# --- 아직 없는 것들 (확정되면 여기에 추가하고 compose 의 app.environment 에도 연결) ---
# ZYXEL_API_KEY=
# KAKAO_ALIMTALK_API_KEY=
# PREMIUM_API_KEY=
