POSTGRES_USER=dlab
POSTGRES_PASSWORD=dlab_local_password
POSTGRES_DB=dlab_local

# --- 파일 저장소 (S3) ---
# 로컬에서 파일 기능을 쓸 때만 채운다. 비어 있으면 업로드만 안 되고 앱은 정상 기동한다.
S3_REGION=ap-northeast-2
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- 문자·알림톡 (알리고) ---
# ★ 비우면 목업이 남아 인증번호가 로그로만 찍힌다(API 는 200 을 준다).
# ★ 발신번호는 알리고에 사전 등록된 번호만 쓸 수 있다.
# ★★ TEST_MODE=true 면 과금도 실제 발송도 없이 호출만 성공한다 — 운영은 false.
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_KEY=
ALIGO_SENDER_PHONE=
ALIGO_TEST_MODE=true
