# 로컬 개발용 설정 템플릿
# 사용법: 이 파일을 복사해서 파일명을 application-local.yml로 바꾸고 값을 채운다.
#   cp application-local.yml.example application-local.yml
# application-local.yml은 .gitignore에 걸려있어 git에 올라가지 않는다.
# 이 값들은 docker-compose.yml / .env에 맞춰져 있음 (docker compose up -d로 띄운 DB 기준)

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/dlab_local
    username: dlab
    password: dlab_local_password

  data:
      redis:
        host: localhost
        port: 6379

  jpa:
    hibernate:
      ddl-auto: validate   # 스키마는 Flyway가 관리하므로 JPA가 건드리지 않게 validate 유지
    show-sql: true         # 로컬 개발 중엔 SQL 로그 보이게

  flyway:
    enabled: true
    locations: classpath:db/migration
    # 타임스탬프 버전이라 늦게 푸시된 과거 시각 마이그레이션이 뒤늦게 올 수 있다.
    # 개발 환경만 허용한다 — 운영은 순차 배포라 발생하지 않는다.
    out-of-order: true

# --- 아래는 나중에 실제 연동 붙일 때 채울 것들 (지금은 비워둬도 앱 실행엔 지장 없음) ---

# JWT — secret은 절대 커밋하지 않는다(CLAUDE.md §8). 운영은 환경변수로만 공급.
jwt:
  # ★ 최소 32바이트(HS256 요구). 짧으면 기동 시 실패한다.
  secret: local-only-dev-secret-please-change-me-32b
  access-token-ttl: 30m
  refresh-token-ttl: 14d

# zyxel:
#   api-key: <나중에>

# kakao:
#   alimtalk-api-key: <나중에>

# --- RDS로 전환할 때는 url/username/password만 아래처럼 교체하면 됨 (나머지 설정 그대로) ---
# url: jdbc:postgresql://<RDS 엔드포인트>:5432/<DB명>
# username: <RDS 계정>
# password: <RDS 비밀번호>